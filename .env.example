# Required application settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Public canonical URLs (no trailing slash)
BACKEND_PUBLIC_URL=https://your-backend.onrender.com
FRONTEND_PUBLIC_URL=https://www.example.org
# Optional override; otherwise /static/og-default.svg is used
DEFAULT_OG_IMAGE_URL=https://your-backend.onrender.com/static/og-default.svg

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta / Instagram (only enables posting when all values are present)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com/v23.0

# Meta / Facebook Page (only enables posting when all values are present)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0

# A publication with an ambiguous provider response is never retried automatically.
SOCIAL_MAX_ATTEMPTS=3
